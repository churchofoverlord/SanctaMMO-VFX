      "vertex": "attribute vec3 aO; attribute float aT, aY, aD; uniform float uTime; varying float vS, vY, vF; vec3 arcP(vec3 O, float yaw, float d, float s){ vec3 f = vec3(-sin(yaw), 0., -cos(yaw));\n  return O + f*d*s + vec3(0., (.5 + .22*d)*4.*s*(1. - s), 0.); }\n    void main(){ float u = uTime - aT, T = .32 + .045*aD; if (u < 0. || u > T + .25){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float head = clamp(u/T, 0., 1.), tail = clamp((u - T*.35)/(T*.65 + .25), 0., 1.);\n      float s = mix(tail, head, position.x*.5 + .5);\n      vec3 P = arcP(aO, aY, aD, s) + vec3(0., .95, 0.), Tn = normalize(arcP(aO, aY, aD, min(s + .01, 1.)) - arcP(aO, aY, aD, max(s - .01, 0.)));\n      vec3 side = normalize(cross(Tn, P - cameraPosition));\n      vS = position.x*.5 + .5; vY = position.y; vF = 1. - smoothstep(T, T + .25, u);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*.035, 1.); }",
