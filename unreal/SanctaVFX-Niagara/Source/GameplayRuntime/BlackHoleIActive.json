      "vertex": "attribute vec3 aO; attribute float aT; attribute vec2 aP; uniform float uTime; varying vec2 vS; varying float vU, vF, vD;\n    vec3 armAt(float s, vec3 C, vec3 e1, vec3 e2, vec3 n, float spin, float grow){\n      float r = mix(.36, 3.500, s*grow), a = aP.x*6.28318 + spin/6. - 2.8*r/3.500;\n      a += sin(s*5. - uTime*.4 + aP.y*6.28318)*.16*sin(3.14159*s);          /* from the orb out to the outer border */\n      vec3 G = vec3(C.x, .06, C.z);\n      return G + (e1*cos(a) + e2*sin(a))*r + n*(C.y - .06)*pow(1. - s*grow, 2.2);      /* the arm EXTENDS out of the orb (scaling a spiral would read as a backwards spin) */      /* funnel: high at the orb, down to the ground at the rim */\n    }\n    void main(){\n      float u = uTime - aT; if (u < 0. || u > 4.500){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec3 C = aO + vec3(0., 1.35 + .05*sin(uTime*1.3), 0.);\n      vec3 n = vec3(0., 1., 0.), d0 = vec3(0., 0., 1.);\n      vec3 e1 = normalize(cross(n, d0)), e2 = cross(e1, n);\n      float grow = 1. - pow(1. - clamp((u - .3)/1.6, 0., 1.), 3.), spin = -u*7.;            /* slower than the Vortex, swirling inward */\n      float s = position.x + .5;\n      vec3 P = armAt(s, C, e1, e2, n, spin, grow), T = normalize(armAt(min(s + .02, 1.), C, e1, e2, n, spin, grow) - armAt(max(s - .02, 0.), C, e1, e2, n, spin, grow));\n      vec3 side = normalize(cross(n, T));\n      float w = (.06 + .19*pow(s, .8) + .16*exp(-s*9.))*grow*(.74 + .26*sin(s*8. - u*.7 + aP.y*6.));                               /* wide at the orb: the violet rim leaks out into the arm */\n      vec3 W = P + side*position.y*2.*w; vD = length(W - C);                             /* distance to the orb centre: round (never polygonal) base */\n      gl_Position = projectionMatrix*viewMatrix*vec4(W, 1.);\n      vS = vec2(s, position.y*2.); vU = u + aP.y*7.; vF = smoothstep(.3, 1.9, u)*(1. - smoothstep(3.000, 4.500, u));   /* arms start invisible, reach full opacity mid-life, fade out slowly at the end */\n    }",
      "fragment": "varying vec2 vS; varying float vU, vF, vD;\n    float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5); }\n    float vn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n      return mix(mix(h(i), h(i + vec2(1., 0.)), f.x), mix(h(i + vec2(0., 1.)), h(i + vec2(1., 1.)), f.x), f.y); }\n    void main(){\n      float s = vS.x, y = vS.y, t = vU;\n      float n1 = vn(vec2(s*3.5 + t*1.4, y*2. + t*.4)), n2 = vn(vec2(s*5. + t*2., y*2.5 - t*.6));   /* texture flows INWARD */\n      float n = n1*.65 + n2*.35, yy = y + (n1 - .5)*.5;\n      float body = exp(-yy*yy*(2.2 + 1.5*step(0., yy)));\n      float lick = smoothstep(.05, .95, n + .5*(1. - abs(yy)));\n      float streak = smoothstep(.05, .95, vn(vec2(s*2. + t*1.1, yy*3.5 + n1*1.2))*.7 + vn(vec2(s*3.5 + t*1.4, yy*6.))*.3);\n      float dens = body*lick*(.55 + .45*streak)*smoothstep(1., .93, s)*smoothstep(.0, .025, s)*smoothstep(1., .82, abs(y));\n      float T = clamp((1. - .3*s)*(.4 + .6*body*mix(1., streak, .4))*(.9 + .2*n), 0., 1.);\n      /* violet ramp: dark dust -> deep violet -> violet -> pale lilac only in the hottest veins */\n      vec3 dust = vec3(.01, .006, .016), deep = vec3(.16, .03, .34), vio = vec3(.5, .2, 1.), lil = vec3(.63, .34, 1.);\n      vec3 col = T < .25 ? mix(dust, deep, T/.25) : T < .6 ? mix(deep, vio, (T - .25)/.35) : mix(vio, lil, clamp((T - .6)/.4, 0., 1.));\n      float emit = T < .25 ? .06 : .52*T, alpha = dens*mix(.35, .08, clamp(T/.6, 0., 1.));\n      float glow = exp(-y*y*2.5)*smoothstep(1., .9, s)*smoothstep(.0, .03, s)*smoothstep(1., .85, abs(y))*(1. - .3*s)*(1. + .3*exp(-s*10.));   /* brighter where it leaves the rim */\n      vec3 g = vec3(.45, .18, 1.)*glow*.09;\n      if (dens < .003 && glow < .003){ discard; }\n      float fo = pow(max(0., 1. - s), 1.65)*vF*smoothstep(.46, .66, vD);                                               /* fades out away from the centre: almost gone at the rim */\n      gl_FragColor = vec4((col*emit*dens + g)*fo, alpha*fo);\n    }",
