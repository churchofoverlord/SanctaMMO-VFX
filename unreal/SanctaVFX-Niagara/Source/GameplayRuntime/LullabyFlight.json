      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying vec2 vP; varying float vU; vec3 arcAt(vec3 a, vec3 b, float f){ float e = sin(3.14159*f); return mix(a, b, f) + vec3(0., .16*sin(f*18.)*e + .35*e, 0.); }\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/4.0;\n      if (u < 0. || u > tt){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec4 mv = viewMatrix*vec4(arcAt(aO, aE, u/tt), 1.); float S = .32;\n      float c = cos(u*.8), s = sin(u*.8); vec2 q = mat2(c, -s, s, c)*position.xy;       // the crescent rocks very slowly\n      mv.xy += q*S*1.25; vP = position.xy; vU = u; gl_Position = projectionMatrix*mv;\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying vec2 vP; varying float vU;\n    void main(){                                              // astral star: 4 long points + 4 short, bright core, soft halo\n      vec2 p = vP; float r = length(p), a = atan(p.y, p.x);\n      float orb = exp(-r*r*14.), rim = exp(-pow((r - .3)/.05, 2.))*.5;                 // soft round silhouette\n      float moon = smoothstep(.36, .3, r)*smoothstep(.2, .26, length(p - vec2(.13, .08)));   // a thin crescent inside\n      float core = exp(-r*r*50.)*.5, halo = exp(-r*r*4.)*.2;\n      vec3 o = (uOrange*(orb*.6 + rim + halo) + mix(uGold, vec3(1.), .5)*(moon*.9 + core))*smoothstep(1., .85, r);\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
