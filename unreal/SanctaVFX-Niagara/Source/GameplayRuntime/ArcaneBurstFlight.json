      "vertex": "attribute vec3 aO, aE; attribute float aT, aS; uniform float uTime; varying vec2 vP; varying float vU; vec3 arcAt(vec3 a, vec3 b, float f, float sd){\n    vec3 d = b - a; float L = length(d); vec3 side = normalize(cross(d, vec3(0., 1., 0.)));\n    float h = fract(sin(sd*91.7)*43758.5), sg = h < .5 ? -1. : 1.;\n    float lat = sg*L*(.03 + .025*fract(h*7.))*sin(3.14159*f) + L*.008*sin(6.28318*f + h*6.);   // main bow + a faint S wobble\n    float up = L*.015*sin(3.14159*f);\n    return mix(a, b, f) + side*lat + vec3(0., up, 0.); }\n    void main(){\n      float u = uTime - aT - 0.40, L = length(aE - aO), tt = L/14.0;\n      if (u < 0. || u > tt + 0.06){ gl_Position = vec4(2.,2.,2.,1.); return; }                      // holds on the target during the hit stop\n      float grow = 1. - pow(1. - clamp(u/.08, 0., 1.), 3.);                  // forms in the hand from the converged shards\n      vec4 mv = viewMatrix*vec4(arcAt(aO, aE, min(u/tt, 1.), 0.), 1.); mv.xyz += normalize(-mv.xyz)*.1;\n      mv.xy += position.xy*aS*grow*1.25; vP = position.xy; vU = u; gl_Position = projectionMatrix*mv;\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying vec2 vP; varying float vU;\n    void main(){                                              // opaque arcane sphere: lit body, thin bright rim, small highlight, short halo\n      vec2 p = vP/.8; float r = length(p);\n      float z = sqrt(max(1. - r*r, 0.)), lit = .35 + .65*max(dot(vec3(p, z), normalize(vec3(-.4, .5, .75))), 0.);\n      float body = smoothstep(1., .96, r), rim = exp(-pow((r - .97)/.05, 2.));\n      float spec = exp(-dot(p - vec2(-.3, .35), p - vec2(-.3, .35))*28.)*body;\n      float swirl = .85 + .15*sin(atan(p.y, p.x)*3. + vU*9. + r*8.);        // slow arcane churn inside\n      float halo = exp(-max(r - 1., 0.)*9.)*(1. - body)*.18;\n      vec3 o = (uOrange*(body*lit*.55*swirl + rim*.9 + halo) + uGold*spec*.7 + mix(uGold, vec3(1.), .5)*rim*.3)*smoothstep(1.25, 1.1, r);\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
