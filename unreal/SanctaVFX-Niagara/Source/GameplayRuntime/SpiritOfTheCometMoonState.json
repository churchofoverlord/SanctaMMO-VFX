      "vertex": "attribute vec3 aO; attribute vec2 aT, aP, aS; attribute float aV; uniform float uTime; varying vec2 vQ; varying float vK, vPk, vPend, vSpin; float eox(float x){ return x >= 1. ? 1. : 1. - pow(2., -10.*x); } vec3 orbP(vec3 o, float a, float k, float b){ return o + vec3(cos(a)*0.720*k, 1.380 + b + sin(a)*0.158*k, -sin(a)*0.720*k); }\n    void main(){ float u = uTime - aT.x; if (aV < .5 || u < 0.){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float n = aP.y; if (n > 1.5 && n < 3.5 && aS.x < n - 1.5){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float k = eox(clamp(u/.3, 0., 1.)), pu = uTime - aT.y, pp = pu >= 0. && pu < .6 ? exp(-pu*6.) : 0.;\n      vPk = (u < .033 ? 2.2 : 1. + .8*exp(-max(u - .033, 0.)*8.)) + 1.3*pp; vK = n; vPend = aS.y; vSpin = uTime*.35 + aP.x;\n      float ang = aP.x + uTime*1.600, b = .05*sin(uTime*1.3 + aP.x*2.);\n      if (n < .5){ vec3 c = orbP(aO, ang, k, b);\n        float sz = 0.240*mix(.2, 1., k)*(1. + (pu >= 0. && pu < .4 ? .22*sin(3.14159*pu/.4) : 0.));\n        vec4 mv = viewMatrix*vec4(c, 1.); mv.xy += position.xy*sz; vQ = position.xy; gl_Position = projectionMatrix*mv; return; }\n      if (n < 1.5){ float s = (position.x + 1.)*.5, a = ang - s*2.600*k;\n        vec3 p = orbP(aO, a, k, b), T = normalize(orbP(aO, a + .02, k, b) - p), V = normalize(cameraPosition - p);\n        vec3 sd = normalize(cross(T, V)); float w = .07*pow(1. - s, .6)*(.9 + .1*sin(s*9. - uTime*4.));   /* thin hot core streak joining the puffs */\n        p += sd*position.y*w; vQ = vec2(s, position.y); gl_Position = projectionMatrix*viewMatrix*vec4(p, 1.); return; }\n      if (n > 3.5){                                   /* 3D tail: 12 soft flame puffs along the orbit arc - reads as a volume from any angle */\n        float s = (n - 4.)/11., jit = fract(sin(n*37.3 + aP.x)*431.7);\n        float a = ang - (.06 + s*2.600)*k;\n        vec3 c = orbP(aO, a, k, b) + vec3(sin(uTime*5. + n*1.7), cos(uTime*4.3 + n*2.3), sin(uTime*3.7 + n))*.05*s;\n        float sz = mix(.145, .065, s)*k*(.85 + .3*jit);\n        vec4 mv = viewMatrix*vec4(c, 1.); float cr = uTime*.8*(jit - .5) + n; mv.xy += mat2(cos(cr), -sin(cr), sin(cr), cos(cr))*position.xy*sz;\n        vQ = position.xy; vSpin = s; gl_Position = projectionMatrix*mv; return; }\n      float sa = uTime*2.2 + (n - 2.)*3.14159; vec3 c = orbP(aO, ang, k, b) + vec3(cos(sa)*.2, sin(sa)*.1, sin(sa)*.2);\n      vec4 mv = viewMatrix*vec4(c, 1.); mv.xy += position.xy*.035*k; vQ = position.xy; gl_Position = projectionMatrix*mv; }",
      "fragment": "uniform float uTime; uniform vec3 uC, uP; varying vec2 vQ; varying float vK, vPk, vPend, vSpin; float star(vec2 q, float sz){ float r = length(q), a = atan(q.y, q.x); return pow(abs(cos(a*2.)), 12.)*exp(-r/sz*1.4) + exp(-r*r/(sz*sz*.08)); } float h1(float n){ return fract(sin(n*91.7)*43758.5); }\n    void main(){ vec3 o;\n      if (vK < .5){\n        vec2 q = vQ; float r = length(q), a = atan(q.y, q.x);\n        float bd = r - .3, rim = exp(-pow(bd/.035, 2.)), fill = smoothstep(.02, -.03, bd)*.06;   /* dark head, bright rim (icon) */\n        vec2 e = vec2(abs(q.x) - .095, q.y + .01)*vec2(1.6, .75); float eye = smoothstep(.052, .036, length(e));   /* two bright oval eyes */\n\n        float sl = eye*.9, sf = exp(-pow(max(r - .3, 0.)/.12, 2.))*smoothstep(.26, .32, r)*.20;   /* eyes + corona outside the rim */\n        float pend = vPend*(.75 + .25*sin(uTime*3.))*exp(-r*r*5.)*.35;                 /* Moon Pending: discrete glow on the Spirit */\n        o = uC*(rim*1.1 + fill + sf + pend) + uP*(rim*.5 + sl);\n        o *= smoothstep(1., .9, r);\n      } else if (vK < 1.5){\n        /* comet tail: 3 wispy strands flowing back from the head (icon), fading along the arc */\n        float s = vQ.x, y = vQ.y, along = pow(1. - s, 1.2)*smoothstep(.04, .12, s), lum = 0.;\n        for (int i=0;i<5;i++){ float fi = float(i), y0 = (fi - 2.)*.28*(.3 + s) + .14*sin(s*6. - uTime*7. + fi*2.1)*s;   /* flame tongues */\n          lum += exp(-pow((y - y0)/(.1 + .12*s), 2.))*(.6 + .4*sin(s*14. - uTime*9. + fi*1.7))*(1. - .15*fi*s); }\n        o = (uC*lum*.45 + uP*exp(-y*y*6.)*.22*pow(1. - s, 2.))*along*(1. - smoothstep(.8, 1., abs(y)));\n      } else if (vK > 3.5){                            /* flame puff: soft, uneven, hotter near the head, fading down the tail */\n        float r = length(vQ), s = vSpin, a = atan(vQ.y, vQ.x);\n        float n = .75 + .25*sin(a*3. + uTime*6. + vK*1.3)*sin(r*9. - uTime*5.);\n        float d = exp(-r*r*3.2)*n*smoothstep(1., .7, r), fade = pow(1. - s, 1.1)*.19;\n        o = (uC*d + uP*exp(-r*r*14.)*pow(1. - s, 2.)*.22)*fade;\n      } else { float r = length(vQ); o = (uC*star(vQ, .3) + uP*exp(-r*r*70.))*.8*smoothstep(1., .82, r); }\n      o *= vPk; o = max(o, 0.); if (!(max(o.r, max(o.g, o.b)) >= .002)) discard; gl_FragColor = vec4(o, 1.); }",
