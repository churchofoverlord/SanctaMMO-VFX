      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying vec2 vP; varying float vU; vec3 arcAt(vec3 a, vec3 b, float f){ return mix(a, b, f); }\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/18.0;\n      if (u < 0. || u > tt){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec4 mv = viewMatrix*vec4(arcAt(aO, aE, u/tt), 1.); float S = .32;\n      float c = cos(u*6.), s = sin(u*6.); vec2 q = mat2(c, -s, s, c)*position.xy;       // corona churns\n      mv.xy += q*S*1.2; vP = position.xy; vU = u; gl_Position = projectionMatrix*mv;\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying vec2 vP; varying float vU;\n    void main(){                                              // electric orb: hot core, gold sphere, crackling jagged corona that re-strikes\n      vec2 p = vP; float r = length(p), a = atan(p.y, p.x), st = floor(vU*26.);\n      float fl = pow(.5 + .5*sin(a*9. + st*2.3)*sin(a*4. - st*1.7), 3.);   // jagged sparks around the rim, re-striking ~26×/s\n      float sphere = smoothstep(.3, .24, r), corona = exp(-pow(max(r - .26, 0.)/(.03 + .22*fl), 2.))*step(.24, r);\n      float core = exp(-r*r*40.), halo = exp(-r*r*5.)*.2;\n      vec3 o = (uOrange*(corona*1.1 + halo + sphere*.5) + uGold*sphere*.9 + vec3(1., .9, .7)*core*.9)*smoothstep(1., .85, r);\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
