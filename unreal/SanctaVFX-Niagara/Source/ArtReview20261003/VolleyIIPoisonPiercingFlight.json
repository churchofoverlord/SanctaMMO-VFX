      "vertex": "attribute vec3 aO, aE; attribute float aT; attribute vec2 aA; uniform float uTime; varying float vS, vY, vF;\n    vec3 path(float s){ return mix(aO, aE, s) + vec3(0., 4.*aA.x*s*(1. - s), 0.); }\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/30.0;\n      if (u < 0. || u > tt + .2){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float head = min(u/tt, 1.), tail = max(0., head - 1.2*aA.y/L) + max(0., u - tt)/.2*1.7*aA.y/L;   // after the hit, the tail catches up\n      if (head - tail < .002){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5, p = mix(tail, head - .22*aA.y/L, s);\n      vec3 P = path(p), d = normalize(aE - aO + vec3(0., 4.*aA.x*(1. - 2.*p), 0.));\n      vec3 side = normalize(cross(d, P - cameraPosition));\n      vS = s; vY = position.y; vF = 1. - clamp((u - tt)/.2, 0., 1.);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*.03*aA.y, 1.);\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying float vS, vY, vF;\n    void main(){ float a = pow(vS, 1.6)*exp(-vY*vY*5.), c = pow(vS, 3.)*exp(-vY*vY*30.);\n      vec3 o = (mix(uOrange, uGold, .3*vS)*a*.6 + mix(uOrange, uGold, .6)*c*.4)*vF;   // trail in the DoT colour\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
