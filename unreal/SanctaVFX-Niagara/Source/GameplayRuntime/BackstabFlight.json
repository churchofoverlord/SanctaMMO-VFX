      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying float vS, vY, vF;\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/24.0;\n      if (u < 0. || u > tt + .2){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec3 d = (aE - aO)/L;\n      float head = min(u*24.0, L), tail = max(0., head - 1.7) + max(0., u - tt)/.2*1.7;   // after the hit, the tail catches up\n      if (head - tail < .01){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5;\n      vec3 P = aO + d*mix(tail, head - .3, s);\n      vec3 side = normalize(cross(d, P - cameraPosition));\n      vS = s; vY = position.y; vF = 1. - clamp((u - tt)/.2, 0., 1.);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*.03, 1.);\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying float vS, vY, vF;\n    void main(){ float a = pow(vS, 1.6)*exp(-vY*vY*5.), c = pow(vS, 3.)*exp(-vY*vY*30.);\n      vec3 o = (mix(uOrange, uGold, .6)*a*.55 + vec3(1., .95, .85)*c*.35)*vF;\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
