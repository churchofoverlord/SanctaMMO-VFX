      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying vec3 vN, vV;\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/36.0;\n      if (u < 0. || u > tt){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec3 d = (aE - aO)/L, up = vec3(0., 1., 0.), sd = normalize(cross(d, up)), vu = cross(sd, d);\n      float a = u*18.;                                       // flies point first, a slow roll about its axis\n      vec3 b1 = sd*cos(a) + vu*sin(a), b2 = cross(d, b1);\n      vec3 P = mix(aO, aE, u/tt) + d*.05 + d*position.x + b2*position.y + b1*position.z;\n      vN = normalize(d*normal.x + b2*normal.y + b1*normal.z); vV = normalize(cameraPosition - P);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P, 1.);\n    }",
      "fragment": "uniform vec3 uGold, uMoon; varying vec3 vN, vV;\n    void main(){ vec3 n = normalize(vN); float l = .18 + .7*max(dot(n, uMoon), 0.), rim = pow(1. - abs(dot(n, normalize(vV))), 3.);\n      gl_FragColor = vec4(vec3(.62, .6, .6)*l*.7 + uGold*(.12 + rim*1.3), 1.); }",
