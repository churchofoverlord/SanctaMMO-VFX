      "fragment": "uniform float uTime; uniform vec3 uGold, uOrange; varying vec2 vQ; varying float vL, vU, vE, vBrk, vEnd, vK, vDir;\n    float eox(float x){ return x >= 1. ? 1. : 1. - pow(2., -10.*x); } float fly(float x){ x = clamp(x, 0., 1.); return x*(.3 + .7*x); }\n    void main(){\n      float lum = 0., hot = 0.;\n      if (vK > 2.5){                                     /* projectile: 4-point star head + short tail */\n        vec2 q = vQ; vec2 h = vec2((q.x - .72)*.45/.16, q.y); float r = length(h), a = atan(h.y, h.x);\n        float st = pow(abs(cos(a*2.)), 16.)*exp(-r*2.6) + exp(-r*r*6.)*.6;\n        float tail = exp(-q.y*q.y*9.)*smoothstep(-1., .7, q.x)*smoothstep(.95, .7, q.x)*.55;\n        lum = (st + tail)*smoothstep(1., .85, abs(q.y))*smoothstep(-1., -.8, q.x); hot = exp(-r*r*40.)*1.4;\n        vec3 o = uOrange*lum + mix(uGold, vec3(1.), .45)*hot;\n        if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); return; }\n      // last tick phase: ticks at k*TICK (k >= 1) that start before the end\n      float arr = vL/7.000, tt = vU - arr - 1.000, kq = floor(tt), ph = tt - kq, tickOk = tt >= 0. && arr + (kq + 1.)*1.000 < vEnd ? 1. : 0.;\n      if (abs(vK - 1.) > .5){\n        float s = vQ.x, y = vQ.y*0.090;\n        float trav = vL/7.000, grow = fly(vU/trav);\n        float sg = s; float m = smoothstep(grow, grow - .02, sg)*smoothstep(0., .015, s)*smoothstep(1., .985, s);\n        float fl = .55 + .45*pow(.5 + .5*sin(s*vL*2.5 - vDir*uTime*3.), 2.);            /* soft, even flow along each strand */\n        float extra = 0.;\n        float core = exp(-y*y/(.0045*.0045)), glow = exp(-y*y/(.024*.024))*.28;\n        float blob = 0.;\n        if (vDir > 0. && tickOk > .5 && ph < 0.350){ float sp = ph/0.350; blob = exp(-pow((s - sp)*vL/.3, 2.)); }\n        float tip = vU < trav ? exp(-pow((sg - grow)*vL/.2, 2.))*.6 : 0.;\n        lum = (core*.9*fl + glow*(fl + 1.6*blob) + extra + core*blob*1.4 + tip*(core + glow))*m;\n        hot = (core*