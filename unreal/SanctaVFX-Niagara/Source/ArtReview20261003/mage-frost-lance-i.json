      "vertex": "attribute vec3 aO, aE; attribute float aT, aK; attribute vec3 bary; uniform float uTime; varying vec3 vN, vV, vB; varying vec2 vQ; varying float vZ, vK, vU;\n    float hh(float n){ return fract(sin(n*91.7)*43758.5); }\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/16.0;\n      if (u < 0. || u > tt){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec3 f = (aE - aO)/L, s0 = normalize(cross(f, vec3(0., 1., 0.))), up = cross(s0, f);\n      float R = .14, Z = .85, lag = 0., sp = .5 + u*1.2;                 /* the blade rolls slowly: its flat face keeps catching the light */\n      vec3 off = vec3(0.);\n      if (aK > .5){                                                /* companion shards: small, around and a little behind the lance */\n        float k = aK - 1., a = k*1.2566 + .4 + u*2.;\n        R = .036 + .014*hh(k); Z = .3 + .14*hh(k + 5.); lag = .12 + .45*hh(k + 9.); sp = u*(9. + 4.*hh(k)) + k;\n        off = (s0*cos(a) + up*sin(a))*(.2 + .14*hh(k + 3.)); }\n      vec3 p = position*vec3(R, R, Z);\n      float c = cos(sp), sn = sin(sp); p.xy = mat2(c, -sn, sn, c)*p.xy; vec3 n = normal; n.xy = mat2(c, -sn, sn, c)*n.xy;\n      n = normalize(vec3(n.x/R, n.y/R, n.z/Z));\n      vec3 P = mix(aO, aE, clamp(u/tt, 0., 1.)) - f*lag + off;\n      vec3 W = P + s0*p.x + up*p.y + f*p.z;\n      vN = s0*n.x + up*n.y + f*n.z; vV = normalize(cameraPosition - W); vZ = (position.z + .35)/1.35; vK = aK; vU = u; vB = bary; vQ = vec2(position.x*1.6 + aK*3.7, position.z*Z*2.2);\n      gl_Position = projectionMatrix*viewMatrix*vec4(W, 1.);\n    }",
      "fragment": "uniform vec3 uMoon; varying vec3 vN, vV, vB; varying vec2 vQ; varying float vZ, vK, vU; \n  uniform sampler2D uBG; uniform vec2 uRes;\n  float ih(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5453); }\n  float ivn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n    return mix(mix(ih(i), ih(i + vec2(1., 0.)), f.x), mix(ih(i + vec2(0., 1.)), ih(i + vec2(1., 1.)), f.x), f.y); }\n  float ivn3(vec3 p){ return mix(ivn(p.xy + floor(p.z)*17.13), ivn(p.xy + (floor(p.z) + 1.)*17.13), smoothstep(0., 1., fract(p.z))); }\n  /* n: facet normal (world, facing the camera) · V: to camera · B: unused · h: 0 base → 1 point · q: coords on the crystal\n     (x across, y along) · L: key light. Opaque output: the background comes in through the refraction. */\n  vec4 iceShade(vec3 n,vec3 V,vec3 B,float h,vec2 q,vec3 L){\n n=dot(n,V)<0.?-n:n;float nv=clamp(dot(n,V),0.,1.),fr=.028+.972*pow(1.-nv,5.);\n vec3 R=reflect(-V,n);float spec=pow(max(dot(R,normalize(L)),0.),90.)*1.9+pow(max(dot(R,normalize(V+vec3(-.3,.55,.2))),0.),65.)*.65;\n float thick=(.3+.7*nv)*(1.-.65*clamp(h,0.,1.));float cloud=ivn(q*1.6+vec2(4.7))*.8+ivn(q*3.1)*.2;\n float frost=smoothstep(.64,.88,cloud)*thick,crack=pow(1.-abs(fract(q.y*1.7+q.x*.9)-.5)*2.,55.)*.10*thick;\n vec3 vn=(viewMatrix*vec4(n,0.)).xyz;vec2 suv=gl_FragCoord.xy/uRes;\n vec3 bg=texture2D(uBG,suv-vn.xy*.014*thick).rgb;\n vec3 glass=mix(vec3(.62,.82,.91),vec3(.18,.43,.57),thick);\n vec3 col=bg*glass*.40+glass*(.38+.16*fr)+vec3(.72,.86,.94)*(frost*.25+crack)+vec3(.95,.98,1.)*spec;\n float opacity=clamp(.36+.44*thick+.12*frost+spec*.08,.34,.94);\n return vec4(col,opacity); }\n    void main(){\n      vec3 n = normalize(vN); if (!gl_FrontFacing) n = -n;\n      gl_FragColor = iceShade(n, normalize(vV), vB, vZ, vQ, uMoon);             /* shared ice: translucent, bright facet edges, cold point */\n    }",
