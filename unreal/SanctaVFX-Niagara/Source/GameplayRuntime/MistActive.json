      "vertex": "attribute vec3 aO, aE; attribute float aT; attribute vec4 aP; uniform float uTime; varying vec2 vQ; varying float vU, vW, vSeed, vNear;\n    void main(){\n      float u = uTime - aT; if (u < 0. || u > 6. + .9){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float grow = 1. - pow(1. - clamp(u/.6, 0., 1.), 3.);\n      float ang = aP.x + u*.06*(aP.w - .5), r = aP.y*7.0*.92*(.25 + .75*grow);\n      vec3 dir = vec3(cos(ang), 0., sin(ang));\n      vec3 c = aO + dir*r + vec3(0., aP.z*2. + .16*sin(u*.6 + aP.w*6.), 0.) + vec3(sin(u*.25 + aP.w*9.), 0., cos(u*.21 + aP.w*5.))*.36;\n      vec4 mv = viewMatrix*vec4(c, 1.); float S = mix(1.6, 3., aP.w)*(.55 + .45*grow);\n      float near = smoothstep(2.5, 6., length(cameraPosition - c));\n      S = min(S, max(.1, -mv.z)*.27);\n      mv.xy += position.xy*S*vec2(1.25, .8);                                 // wider than tall: low-lying vapour\n      vQ = position.xy; vU = u; vW = dot(dir, aE)*aP.y; vSeed = aP.w; vNear = near;\n      gl_Position = projectionMatrix*mv;\n    }",
      "fragment": "uniform vec3 uOrange, uIceC; varying vec2 vQ; varying float vU, vW, vSeed, vNear;\n    float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5); }\n    float vn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n      return mix(mix(h(i), h(i + vec2(1., 0.)), f.x), mix(h(i + vec2(0., 1.)), h(i + vec2(1., 1.)), f.x), f.y); }\n    void main(){\n      vec2 q = vQ; float d = length(q);\n      vec2 warp = vec2(vn(q*2. + vSeed*7.), vn(q*2.4 - vSeed*5.)) - .5;\n      float n = vn(q*2.1 + warp*.8 + vec2(vSeed*9., -vU*.18))*.72 + vn(q*4.1 + vec2(vU*.11, vSeed*4.))*.28;       // slow alpha erosion\n      float dens = smoothstep(1., .18, d)*smoothstep(.28, .73, n + (1. - d)*.33);\n      dens *= smoothstep(0., .5, vU)*(1. - smoothstep(6., 6. + .9, vU));\n      vec3 steam = mix(vec3(.12, .15, .18), vec3(.38, .42, .46), smoothstep(.24, .8, n));\n      vec3 tint = mix(uIceC, uOrange, smoothstep(-.6, .6, vW));\n      vec3 col = mix(steam, tint*.45, .13 + .13*abs(clamp(vW, -1., 1.)))*(.55 + .45*n);\n      float a = dens*.52*mix(.82, 1.12, vSeed)*vNear;\n\n      gl_FragColor = vec4(col*a, a);\n    }",
