      "vertex": "attribute vec3 aO; attribute float aT; uniform float uTime; varying vec2 vQ; varying float vU;\n    void main(){ float u = uTime - aT; if (u < 0. || u > .45){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec4 mv = viewMatrix*vec4(aO, 1.); mv.xyz += normalize(-mv.xyz)*.3; mv.xy += position.xy*.45; vQ = position.xy; vU = u; gl_Position = projectionMatrix*mv; }",
      "fragment": "uniform vec3 uC, uCl; varying vec2 vQ; varying float vU;\n    void main(){ float r = length(vQ), a = atan(vQ.y, vQ.x);\n      float star = pow(abs(cos(a*2.)), 30.)*exp(-r*3.5) + exp(-r*r*40.)*.8;\n      float f = (vU < .033 ? 1.8 : 1.)*(1. - smoothstep(.15, .45, vU))*(1. - pow(1. - clamp(vU/.08, 0., 1.), 3.));\n      vec3 o = (uC*star + uCl*exp(-r*r*120.))*f*smoothstep(1., .8, r);\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
