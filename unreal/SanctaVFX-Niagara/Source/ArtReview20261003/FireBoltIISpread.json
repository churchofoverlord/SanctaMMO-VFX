      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying float vS, vY, vF, vU;\n    vec3 arcP(float f){ return mix(aO, aE, f) + vec3(0., .55*sin(3.14159*f)*length(aE - aO)/3., 0.); }\n    void main(){\n      float u = uTime - aT; if (u < 0. || u > 0.450){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float head = 1. - pow(1. - clamp(u/0.300, 0., 1.), 2.), tail = max(0., head - .85) + max(0., u - 0.300)/.15;\n      if (head - tail < .005){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5, f = mix(tail, head, s);\n      vec3 P = arcP(f), T = normalize(arcP(min(f + .01, 1.)) - arcP(max(f - .01, 0.)));\n      vec3 side = normalize(cross(T, P - cameraPosition));\n      vS = s; vY = position.y; vU = uTime; vF = 1. - clamp((u - 0.300)/.15, 0., 1.);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*(.02 + .2*pow(max(sin(3.14159*s), 0.), .7)), 1.);\n    }",
      "fragment": "varying float vS, vY, vF, vU;\n    float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5); }\n    float vn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n      return mix(mix(h(i), h(i + vec2(1., 0.)), f.x), mix(h(i + vec2(0., 1.)), h(i + vec2(1., 1.)), f.x), f.y); }\n    void main(){\n      float s = vS, y = vY + .25*sin(s*9. - vU*20.)*(1. - s);\n      float n = vn(vec2(s*8. - vU*18., y*3.));\n      float dens = exp(-y*y*4.)*pow(max(sin(3.14159*s), 0.), .6)*smoothstep(.2, .7, n + .4*s)*smoothstep(.95, .6, abs(vY));   /* thin at both ends, never a hard cut */\n      float T = clamp(sin(3.14159*min(s*1.15, 1.))*(.55 + .5*exp(-y*y*8.)), 0., 1.);\n      vec3 red = vec3(.5, .06, .01), org = vec3(1., .38, .05), yel = vec3(1., .82, .4);\n      vec3 col = T < .5 ? mix(red*.3, red, T/.5) : (T < .85 ? mix(red, org, (T - .5)/.35) : mix(org, yel, (T - .85)/.15));\n      vec3 o = col*dens*(.7 + 1.6*T)*vF;\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
