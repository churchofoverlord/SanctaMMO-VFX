      "vertex": "attribute vec3 aA, aB, aT; attribute float aK; uniform float uTime; varying vec2 vQ; varying float vL, vU, vE, vBrk, vEnd, vK, vDir;\n    float eox(float x){ return x >= 1. ? 1. : 1. - pow(2., -10.*x); } float fly(float x){ x = clamp(x, 0., 1.); return x*(.3 + .7*x); }\n    void main(){\n      vec3 d = aB - aA; float L = length(d);\n      if (aK > 2.5){                                   /* projectile: hand -> chest in (aT.y - aT.x), slight arc */\n        float u = uTime - aT.x, tt = aT.y - aT.x; if (u < 0. || u > tt){ gl_Position = vec4(2.,2.,2.,1.); return; }\n        float f = fly(u/tt); vec3 P = aA + d*f + vec3(0., -.012*L*sin(3.14159*f), 0.);\n        vec4 c0 = projectionMatrix*viewMatrix*vec4(P, 1.), c1 = c0;\n        vec2 sd = c1.xy/c1.w - c0.xy/c0.w; sd = length(sd) > 1e-5 ? normalize(sd) : vec2(1., 0.);\n        vec4 mv = viewMatrix*vec4(P, 1.); vec2 q = position.xy;\n        vec2 dir = normalize((viewMatrix*vec4(d, 0.)).xy + 1e-5), nrm = vec2(-dir.y, dir.x);\n        mv.xy += dir*(q.x*.45 - .25) + nrm*q.y*.16;     /* stretched along the flight, head at the front */\n        vK = aK; vDir = 1.; vU = u; vL = L; vE = -1.; vBrk = 0.; vEnd = 1e9; vQ = q;\n        gl_Position = projectionMatrix*mv; return; }\n      float u = uTime - aT.x, endR = min(aT.y, aT.z) - aT.x, e = u - endR; if (u < 0. || e > .4){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vK = aK; vDir = aK > 1.5 ? -1. : 1.; vL = L; vU = u; vE = e; vBrk = aT.z < aT.y ? 1. : 0.; vEnd = endR;\n      if (abs(aK - 1.) > .5){\n        float s = position.x*.5 + .5;\n        vec3 ax = d/L, n1 = normalize(cross(ax, vec3(0., 1., 0.))), n2 = cross(n1, ax);\n        float g = fly(u/(L/7.000)), ph = s*6.2832*2.5 + (aK > 1.5 ? 3.14159 : 0.) + uTime*.8, R = .1*pow(sin(3.14159*s), .8)*clamp((g - s)*L/.6, 0., 1.);\n        vec3 P = aA + d*s + vec3(0., -.012*L*sin(3.14159*s), 0.) + vec3(0., sin(s*L*1.2 - uTime*2.)*.018*sin(3.14159*s), 0.) + (n1*cos(ph) + n2*sin(ph))*R;\n        vec3 side = normal