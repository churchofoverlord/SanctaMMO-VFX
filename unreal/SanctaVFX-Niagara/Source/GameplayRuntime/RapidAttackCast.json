      "vertex": "attribute vec3 aO, aF; attribute float aT, aS, aL, aK; uniform float uTime; varying float vS, vY, vU;\n    void main(){ float u = uTime - aT; if (u < 0. || u > aL){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float t = u/aL, head = 1. - pow(1. - clamp(t/.45, 0., 1.), 3.), tail = clamp((t - .35)/.65, 0., 1.);\n      float s = position.x*.5 + .5, x = mix(tail, head, s)*.42*aK;\n      vec3 side0 = vec3(1.,0.,0.), up = cross(side0, aF);\n      vec3 P = aO + aF*(x + .04) + (side0*.6 + up)*aS*(1. + x*1.2);           // streaks fan out a little as they fly\n      vec3 cs = normalize(cross(aF, P - cameraPosition));\n      vS = s; vY = position.y; vU = t;\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + cs*position.y*.012, 1.); }",
      "fragment": "uniform vec3 uGold, uOrange; varying float vS, vY, vU;\n    void main(){ float prof = pow(max(0., sin(3.14159*vS)), .5)*(1. - .6*vS), d = abs(vY)/max(prof, .05);\n      float f = (vU < .1 ? 1.6 : 1.)*(1. - smoothstep(.55, 1., vU));\n      vec3 o = (mix(uOrange, uGold, .5)*exp(-d*d*2.5)*.6 + mix(uGold, vec3(1., .96, .88), .6)*exp(-d*d*20.))*prof*f;\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
