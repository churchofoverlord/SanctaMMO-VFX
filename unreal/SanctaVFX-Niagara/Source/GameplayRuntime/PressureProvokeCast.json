      "vertex": "attribute vec3 aA, aB; attribute float aT, aK; uniform float uTime; varying float vS, vY, vU, vK, vL;\n    void main(){\n      float u = uTime - aT - 0.10; if (u < 0. || u > 0.95){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5, W = .16;\n      vec3 d = aB - aA, t = normalize(d);\n      vec3 P = aA + d*s + vec3(0., -.1*4.*s*(1. - s), 0.);       // minimal sag\n      vec3 side = normalize(cross(t, P - cameraPosition));\n      vS = s; vY = position.y*W; vU = u; vK = aK; vL = length(d);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*W, 1.);\n    }",
      "fragment": "uniform vec3 uCW, uCT; varying float vS, vY, vU, vK, vL;\n    float h2(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5453); }\n    float vn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n      return mix(mix(h2(i), h2(i + vec2(1,0)), f.x), mix(h2(i + vec2(0,1)), h2(i + vec2(1,1)), f.x), f.y); }\n    float fbm(vec2 p){ return .55*vn(p) + .3*vn(p*2.1 + 3.7) + .15*vn(p*4.3 + 7.1); }\n    void main(){\n      float s = vS, u = vU, M = 0.09;\n      vec3 col = mix(uCW, uCT, vK);\n      float g = (1. - pow(1. - clamp(u/M, 0., 1.), 2.))*.5;       // forms from both ends and meets in the middle\n      float grown = max(smoothstep(g + .04, g - .06, s), smoothstep(1. - g - .04, 1. - g + .06, s));\n      float wipe = max(u - .55, 0.)/.3;                           // clears from the Fighter's end; the target end goes last\n      float alive = grown*smoothstep(wipe - .1, wipe + .25, s);\n      // smoke drifts fast along the line: toward the target (Pressure) or back toward the Tank (Provoke)\n      float dir = vK < .5 ? 1. : -1., x = s*vL;\n      float n  = fbm(vec2(x*2.2 - dir*u*9., vY*14. + u*1.5));\n      float n2 = fbm(vec2(x*5.  - dir*u*14., vY*26. - u*2.));\n      float prof = pow(sin(3.14159*s), .5);\n      // three loose wisps, each wandering and breaking up on its own — no band, no fixed centre\n      float dens = 0.;\n      for (int i=0;i<3;i++){\n        float fi = float(i);\n        float yy = vY - (fi - 1.)*.042*prof + (fbm(vec2(x*1.1 - dir*u*6. + fi*5.3, fi*2.7)) - .5)*.08;\n        float w = (.009 + .016*prof)*(.7 + .6*fbm(vec2(x*2. - dir*u*8. + fi*3.1, fi + 1.)));\n        float brk = smoothstep(.3, .75, fbm(vec2(x*2.4 - dir*u*12. + fi*7.7, fi*4.3 + 2.)));\n        dens += exp(-pow(abs(yy)/w, 1.6))*brk*(.5 + .5*n2);\n      }\n      dens *= prof*.55;\n      // resolution: denser puffs rush along the smoke\n      float r = u - M, puff = 0.;\n      if (r > 0.){\n        if (vK < .5){ for (int i=0;i<3;i++){ float h = (r - float(i)*.06)*3.6; puff += exp(-pow((s - h)/.08, 2.))*step(0., h)*step(h, 1.08); } }\n        else puff = (.5 + .5*sin((s + r*2.2)*18.))*smoothstep(0., .08, r)*(1. - smoothstep(.35, .5, r))*.7;\n      }\n      vec3 smoke = mix(col, vec3(.55, .55, .6), .35);             // tinted, slightly greyed smoke — not a light beam\n      vec3 outc = smoke*dens*(.28 + .55*puff)*alive;\n      if (max(outc.r, max(outc.g, outc.b)) < .002) discard;\n      gl_FragColor = vec4(outc, 1.);\n    }",
