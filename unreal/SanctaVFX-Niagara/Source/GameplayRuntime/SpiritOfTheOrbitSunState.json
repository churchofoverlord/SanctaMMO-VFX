      "vertex": "attribute vec3 aO; attribute vec2 aT, aP; attribute float aV; uniform float uTime; varying vec2 vQ; varying float vK, vPk, vSpin; float eox(float x){ return x >= 1. ? 1. : 1. - pow(2., -10.*x); } vec3 orbP(vec3 o, float a, float k, float b){ return o + vec3(cos(a)*0.720*k, 1.380 + b + sin(a)*0.158*k, -sin(a)*0.720*k); }\n    void main(){ float u = uTime - aT.x; if (aV < .5 || u < 0.){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float k = eox(clamp(u/.3, 0., 1.)), pu = uTime - aT.y;\n      float pp = pu >= 0. && pu < .6 ? exp(-pu*6.) : 0.;\n      vPk = (u < .033 ? 2.2 : 1. + .8*exp(-max(u - .033, 0.)*8.)) + 1.3*pp;\n      float ang = aP.x + uTime*1.600, b = .05*sin(uTime*1.3 + aP.x*2.);\n      vK = aP.y; vSpin = uTime*.5 + aP.x;\n      if (aP.y < .5){\n        vec3 c = orbP(aO, ang, k, b);\n        float sz = 0.150*mix(.2, 1., k)*(1. + (pu >= 0. && pu < .4 ? .22*sin(3.14159*pu/.4) : 0.));\n        vec4 mv = viewMatrix*vec4(c, 1.); mv.xy += position.xy*sz; vQ = position.xy; gl_Position = projectionMatrix*mv; return; }\n      float s = (position.x + 1.)*.5, a = ang - s*1.200*k;         // arc behind the spirit\n      vec3 p = orbP(aO, a, k, b), T = normalize(orbP(aO, a + .02, k, b) - p), V = normalize(cameraPosition - p);\n      vec3 sd = normalize(cross(T, V));\n      float w = .045*pow(1. - s, .8)*(.85 + .15*sin(s*9. - uTime*4.));\n      p += sd*position.y*w;\n      vQ = vec2(s, position.y); gl_Position = projectionMatrix*viewMatrix*vec4(p, 1.); }",
      "fragment": "uniform float uTime; uniform vec3 uC, uP; varying vec2 vQ; varying float vK, vPk, vSpin;\n    void main(){ vec3 o;\n      if (vK < .5){\n        vec2 q = vQ; float r = length(q);\n        float bd = r - .27, rim = exp(-pow(bd/.03, 2.)), fill = smoothstep(.02, -.03, bd)*.3;\n        vec2 e = vec2(abs(q.x) - .1, q.y - .03)*vec2(1., .7); float eye = smoothstep(.055, .035, length(e));\n        fill *= 1. - eye*.85;                                                        /* two dark eyes, as in the icon */\n        float a = atan(q.y, q.x) - vSpin, a6 = mod(a, 1.0472) - .5236;\n        float d = length(vec2(r*cos(a6) - .56, r*sin(a6)));\n        float orb = exp(-d*d/.0035), ring = exp(-pow((r - .56)/.012, 2.))*.28;\n        o = uC*(rim*.85 + fill + ring + orb*.8 + exp(-r*r*5.)*.1) + uP*(rim*.3 + orb*.5);\n        o *= smoothstep(1., .82, r);\n      } else {\n        float s = vQ.x, y = vQ.y;\n        float along = pow(1. - s, 1.5)*smoothstep(.03, .2, s);\n        float streak = .7 + .3*sin(s*16. - uTime*5. + y*2.5);\n        o = (uC*exp(-y*y*5.)*.5 + uP*exp(-y*y*40.)*.3)*along*streak;\n        o *= 1. - smoothstep(.75, 1., abs(y));\n      }\n      o *= vPk; if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
