      "vertex": "attribute vec3 aO, aE; attribute float aT; attribute vec2 aA; uniform float uTime; varying vec3 vN, vV;\n    vec3 path(float s){ return mix(aO, aE, s) + vec3(0., 4.*aA.x*s*(1. - s), 0.); }             // arced flight (aA.x = apex height)\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/30.0;\n      if (u < 0. || u > tt){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = u/tt;\n      vec3 d = normalize(aE - aO + vec3(0., 4.*aA.x*(1. - 2.*s), 0.)), up = vec3(0., 1., 0.), sd = normalize(cross(d, up)), vu = cross(sd, d);\n      float a = 0.;;                                       // flies point first along the arc, a slow roll about its axis\n      vec3 b1 = sd*cos(a) + vu*sin(a), b2 = cross(d, b1);\n      vec3 q = position*aA.y;                                // aA.y = scale (the single piercing shot is bigger)\n      vec3 P = path(s) + d*.05 + d*q.x + b2*q.y + b1*q.z;\n      vN = normalize(d*normal.x + b2*normal.y + b1*normal.z); vV = normalize(cameraPosition - P);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P, 1.);\n    }",
      "fragment": "uniform vec3 uGold, uMoon; varying vec3 vN, vV;\n    void main(){ vec3 n = normalize(vN); float l = .18 + .7*max(dot(n, uMoon), 0.), rim = pow(1. - abs(dot(n, normalize(vV))), 3.);\n      gl_FragColor = vec4(mix(vec3(.62, .6, .6), uGold, .55)*l*.7 + uGold*(.25 + rim*1.4), 1.); }   // arrow in the DoT colour",
