      "vertex": "attribute vec3 aO; attribute float aT, aK; attribute vec2 aD; uniform float uTime; varying vec2 vP; varying float vF;\n    void main(){ float u = uTime - aT, k = clamp(u/0.67, 0., 1.); if (u < 0. || u > 0.67){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float e = aK < .5 ? k*k : 1. - (1. - k)*(1. - k);\n      float y = aK < .5 ? mix(0., 2., e) : mix(2., 0., e);          // origin: feet → head · destination: head → feet\n      vec3 C = aO + vec3(0., y, 0.);\n      vec3 f = cameraPosition - C; f.y = 0.; f = normalize(f); vec3 rt = vec3(f.z, 0., -f.x);\n      vec3 P = C + rt*position.x*.55 + vec3(0., position.y*.05, 0.);   // a thin horizontal band across the body\n      vP = position.xy; vF = (1.-k*.3)*smoothstep(0.,.08,k)*(1.-smoothstep(.82,1.,k)); gl_Position = projectionMatrix*viewMatrix*vec4(P, 1.); }",
      "fragment": "uniform vec3 uV, uW; varying vec2 vP; varying float vF;\n    void main(){ float ends = smoothstep(1., .55, abs(vP.x));\n      float b = exp(-vP.y*vP.y*4.)*ends, c = exp(-vP.y*vP.y*25.)*ends;\n      vec3 o = (uV*b + uW*c)*vF*1.4; if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
