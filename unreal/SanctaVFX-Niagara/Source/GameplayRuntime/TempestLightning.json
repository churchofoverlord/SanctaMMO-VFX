      "vertex": "attribute vec3 aO, aE; attribute float aT, aK; attribute vec4 aP; uniform float uTime; varying float vS, vY, vF, vFl, vSt;\n    float h1(float x){ return fract(sin(x*127.1)*43758.5); }\n    float jag(float s, float st, float k){ float x = s*k, i = floor(x); return mix(h1(mod(i, k) + st), h1(mod(i + 1., k) + st), fract(x)) - .5; }   // periodic in s: the coil closes without a step\n    vec3 boltAt(float s, float st, vec3 A, vec3 B){                        // fractal zigzag (3 octaves), bowed a little\n      vec3 d = B - A, rf = abs(normalize(d).y) > .9 ? vec3(1., 0., 0.) : vec3(0., 1., 0.), sd = normalize(cross(d, rf)), up = normalize(cross(sd, d));\n      float env = pow(sin(3.14159*s), .7), L = length(d);\n      float j1 = jag(s, st, 7.) + .45*jag(s, st + 3., 19.) + .2*jag(s, st + 9., 43.);\n      float j2 = jag(s, st + 7., 6.) + .45*jag(s, st + 11., 17.) + .2*jag(s, st + 13., 39.);\n      return mix(A, B, s) + (sd*j1 + up*j2)*env*L*.11 + up*env*L*.05;\n    }\n    vec3 at(float s, float st, float u){\n      if (aK < .5){\n        float a = s*6.28318*aP.w + aP.z*6.28 + u*2.5*aP.w, R = aP.y*(1. + .08*jag(s, st, 26.));\n        return aO + vec3(cos(a)*R, aP.x + .09*jag(s, st*1.7 + 3., 20.) + .06*sin(a*2. + aP.z*9.), sin(a)*R);\n      }\n      vec3 A = aO, B = aE;\n      if (aK > 2.5){                                   // ambient strike: a new outward direction every 0.16 s, from a coil point\n        float idx = floor(u/.32 + aP.z), h = h1(idx*1.37 + aP.z*91.), h2 = h1(idx*2.11 + aP.z*37.), h3 = h1(idx*3.7 + aP.z*13.);\n        float a = h*6.28318; vec3 r = vec3(cos(a), 0., sin(a));\n        A = aO + r*.75 + vec3(0., mix(.4, 1.8, h2), 0.);\n        B = A + normalize(r + vec3(0., (h3 - .5)*1.3, 0.))*(.7 + .8*h3);   // shorter strikes\n      }\n      if (aK < 1.5 || (aK > 2.5 && aK < 3.5)) return boltAt(s, st, A, B);\n      // branch: forks off its main bolt at aP.x (same path, computed here), heads outward at angle aP.y for aP.w metres\n      vec3 S = boltAt(aP.x, st, A, B), d = normalize(B - A), rf = abs(d.y) > .9 ? vec3(1., 0., 0.) : vec3(0., 1., 0.), sd = normalize(cross(d, rf)), up = cross(sd, d);\n      vec3 E2 = S + normalize(d*.6 + sd*cos(aP.y) + up*sin(aP.y))*aP.w;\n      return boltAt(s, st + 17., S, E2);\n    }\n    void main(){\n      float u = uTime - aT, life = aK < .5 || aK > 2.5 ? 3. : (aK < 1.5 ? .32 : .24);                       // coils hold ~3 s\n      if (u < 0. || u > life){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float st = (aK > 2.5 ?  floor((uTime - aT)/.32 + aP.z)*3.3 + floor(uTime*26.)*.0 : floor(uTime*(aK < .5 ? 20. : 14.))) + aP.z*50., s = position.x + .5;   // bolts re-strike faster\n      float draw = aK < .5 ? clamp(u/.12, 0., 1.) : 1.;\n      if (s > draw + .002){ gl_Position = vec4(2.,2.,2.,1.); return; }                                           // coil draws itself around in 0.12 s\n      vec3 P = at(s, st, u), T = normalize(at(min(s + .01, 1.), st, u) - at(max(s - .01, 0.), st, u));\n      vec3 side = normalize(cross(T, P - cameraPosition));\n      float w = aK < .5 ? .05 : (aK < 1.5 ? .09 : aK > 2.5 && aK < 3.5 ? .028 : .018)*(.3 + .7*sin(3.14159*s));   // bolts taper at both ends\n      vS = s; vY = position.y*2.; vSt = st; vFl = aK < .5 ? .7 + .3*h1(st*3.1) : step(.22, h1(st*3.1))*(.7 + .6*h1(st*1.7));;   // bolts strobe on/off like real strikes\n      vF = (u < .033 ? 1.8 : 1.)*(aK < .5 ? mix(1., .75, smoothstep(.2, .6, u))*(1. - smoothstep(2.6, 3., u)) : aK > 2.5 ? smoothstep(0., .04, fract(u/.32 + aP.z))*(1. - smoothstep(.22, .34, fract(u/.32 + aP.z)))*.45*(1. - smoothstep(2.6, 3., u))*1.3 : (1. - smoothstep(life*.55, life, u))*1.3);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*w*3.2, 1.);   // wider strip: room for the soft glow\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying float vS, vY, vF, vFl, vSt;\n    float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5); }\n    float vn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n      return mix(mix(h(i), h(i + vec2(1., 0.)), f.x), mix(h(i + vec2(0., 1.)), h(i + vec2(1., 1.)), f.x), f.y); }\n    void main(){\n      // electric \"texture\" (ref): thickness pulses along the strand, the hot core swells and pinches, the edge is a crackling fuzz\n      float y = vY*1.6, sd = vSt*.37;\n      float thick = .55 + .9*vn(vec2(vS*18. + sd, sd*3.)) + .5*pow(vn(vec2(vS*47. - sd, 5.)), 3.);   // uneven width\n      float d = abs(y)/thick;\n      float core = exp(-d*d*30.), glow = exp(-d*d*3.2)*.55, bloom = exp(-abs(y)*2.2)*.22;          // hot core, soft glow, wide faint bloom\n      float fuzz = vn(vec2(vS*120. + sd*7., y*9. + sd)) * vn(vec2(vS*260. - sd*3., y*22.));         // tiny crackles on the edge\n      float crack = smoothstep(.55, .9, fuzz)*exp(-d*d*.9)*(1. - core)*.9;\n      float hot = pow(core, 1.5)*(.6 + .6*vn(vec2(vS*30. + sd*2., 1.)));                            // white-hot where the core swells\n      vec3 o = (uOrange*(glow + bloom + crack*.8) + uGold*core*.7 + vec3(1., .96, .78)*hot*.55)*vF*vFl;\n      o *= smoothstep(1., .75, abs(vY));\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.);\n    }",
