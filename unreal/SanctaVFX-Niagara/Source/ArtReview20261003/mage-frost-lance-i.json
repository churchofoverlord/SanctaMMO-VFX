      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying float vS, vY, vF, vU2, vLen; vec3 arcAt(vec3 a, vec3 b, float f){ return mix(a, b, f); }\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/16.0;\n      if (u < 0. || u > tt + .2){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec3 d = (aE - aO)/L;\n      float head = min(u*16.0, L) - .45, tail = max(0., head - 2.2) + max(0., u - tt)/.2*2.2;   // after the hit, the tail catches up\n      if (head - tail < .01){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5;\n      float fa = mix(tail, head, s)/L;\n      vec3 P = arcAt(aO, aE, fa), T = normalize(arcAt(aO, aE, min(fa + .01, 1.)) - arcAt(aO, aE, max(fa - .01, 0.)));\n      vec3 side = normalize(cross(T, P - cameraPosition));\n      vS = s; vY = position.y; vF = 1. - clamp((u - tt)/.2, 0., 1.); vU2 = uTime; vLen = head - tail;\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*(.04 + .2*pow(s, .8)), 1.);\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying float vS, vY, vF, vU2, vLen;\n    float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5); }\n    float vn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n      return mix(mix(h(i), h(i + vec2(1., 0.)), f.x), mix(h(i + vec2(0., 1.)), h(i + vec2(1., 1.)), f.x), f.y); }\n    void main(){\n      float s = vS, y = vY, t = vU2, m = s*vLen;\n      float n = vn(vec2(m*4. - t*3., y*4.));\n      float mist = exp(-y*y*(14. - 8.*s))*pow(s, 1.3)*(.4 + .6*n)*.35;            /* thin frost wake */\n      vec2 g = vec2(m*9., y*3.); vec2 gi = floor(g), gf = fract(g) - .5; float hs = h(gi + floor(t*.0));\n      vec2 o2 = (vec2(h(gi + 3.), h(gi + 7.)) - .5)*.5;\n      vec2 q = gf - o2; float sh = step(.72, hs)*exp(-(abs(q.x) + abs(q.y))*14.)*(.5 + .5*sin(t*25. + hs*50.))*smoothstep(0., .5, s);   /* small diamond shards */\n      vec3 o = (uOrange*(mist + sh*.8) + uGold*sh*.5)*vF*smoothstep(1., .75, abs(y))*smoothstep(vLen, vLen - .3, m);\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
