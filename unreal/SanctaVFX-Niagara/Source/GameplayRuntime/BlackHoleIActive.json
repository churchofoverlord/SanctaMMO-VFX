      "vertex": "attribute vec3 aO, aE; attribute float aT, aK; uniform float uTime; varying vec2 vP; varying float vU, vK, vLen;\n    void main(){ float u = uTime - aT; if (u < 0. || u > (aK < .5 || aK > 1.5 ? 4.500 : 0.700)){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vU = u; vK = aK;\n      if (aK < .5){ float S = 3.800; vP = position.xy*S; gl_Position = projectionMatrix*viewMatrix*vec4(aO + vec3(vP.x, .03, -vP.y), 1.); return; }\n      if (aK > 1.5){ vec4 mv = viewMatrix*vec4(aO + vec3(0., 1.35 + .05*sin(uTime*1.3), 0.), 1.);   /* the orb, floating above the centre */\n        float S = 1.05*(1. - pow(1. - clamp(u/.3, 0., 1.), 3.))*(1. - smoothstep(4.000, 4.500, u));\n        mv.xy += position.xy*S; vP = position.xy; gl_Position = projectionMatrix*mv; return; }\n      vec3 d = aO - aE; float L = length(d); vec3 dir = d/L, side = vec3(-dir.z, 0., dir.x);\n      float s = position.x*.5 + .5; vP = vec2(s, position.y); vLen = L;\n      gl_Position = projectionMatrix*viewMatrix*vec4(aE + dir*s*L + side*position.y*.3 + vec3(0., .04, 0.), 1.); }",
      "fragment": "uniform float uTime; uniform vec3 uV, uL, uD; varying vec2 vP; varying float vU, vK, vLen; float eox(float x){ return x >= 1. ? 1. : 1. - pow(2., -10.*x); }\n    float line(float d, float w){ return exp(-d*d/(w*w)); }\n    void main(){ vec3 c = vec3(0.); float al = 0.;\n      if (vK < .5){\n        float r = length(vP), a = atan(vP.y, vP.x), R = 3.500;\n        float fin = eox(clamp((vU - .3)/1.6, 0., 1.)), fout = 1. - smoothstep(4.000, 4.500, vU);\n        float Rr = R*mix(.4, 1., fin), f = fin*fout;\n        float rim = line(r - Rr, .03)*.22 + exp(-pow((r - Rr)/.25, 2.))*.04;              /* faint outer border */\n        float sw = a + 2.2*log(max(r, .05)) - vU*.35;                                     /* 4 wide spiral arms turning inward, slowly */\n        float arm = pow(.5 + .5*cos(4.*sw), 5.)*smoothstep(Rr, Rr*.6, r)*smoothstep(.55, 1.1, r);\n        float streak = .6 + .4*sin(sw*4. + r*6. - vU*3.);\n        float hz = line(r - .62, .06)*1.2;                                                 /* violet event horizon */\n        float core = smoothstep(.62, .45, r);                                              /* the black centre stays visible */\n        c = (uV*rim + uL*line(r - Rr, .01)*.08)*f;                                        /* only the faint outer border stays on the ground */\n        al = 0.;\n        c *= smoothstep(R + .3, R + .1, r); al *= smoothstep(R + .3, R + .1, r);\n      } else if (vK > 1.5){\n        /* the orb in the air: a black sphere with a bright violet photon rim, a thin tilted accretion ring swirling\n           around it and a soft glow - premultiplied so the core really reads black */\n        vec2 q = vP; float r = length(q), a = atan(q.y, q.x);\n        float core = 1. - smoothstep(.35, .37, r), rimL = line(r - .365, .015)*.9 + exp(-pow((r - .365)/.055, 2.))*.09;\n        vec2 e = vec2(q.x, q.y*3.2); float er = length(e), ea = atan(e.y, e.x);\n        float disk = line(er - .62, .035)*(.55 + .35*sin(ea*3. - uTime*2.5))*(1. - core*step(0., q.y));   /* ring passes behind the top */\n        float swirl = pow(.5 + .5*cos(a*2. + r*9. - uTime*3.), 4.)*smoothstep(.95, .4, r)*smoothstep(.34, .5, r)*.35;\n        c = uV*(rimL + disk*.62 + swirl*.35 + exp(-r*r*8.)*.018) + uL*(line(r - .365, .005)*.35 + disk*.12);\n        al = core; c *= 1. - core;\n        c *= smoothstep(1., .9, r); al *= smoothstep(1., .9, r);\n      } else {\n        /* the single convergence line (query): a bright arrow travels from the enemy to the centre over 0.6 s, then fades */\n        float s = vP.x, y = vP.y, t = clamp(vU/0.600, 0., 1.), h = eox(t)*1.02;\n        float body = line(y, .25)*smoothstep(h - .45, h, s)*step(s, h)*(1. - smoothstep(.75, 1., t));\n        float head = line(y, .5)*line((s - h)*vLen, .12)*(1. - t*.6);\n        c = (uV*body*1.6 + uL*(head*1.8 + body*.5))*smoothstep(0., .05, s); al = 0.;\n      }\n      if (!(max(c.r, max(c.g, max(c.b, al))) >= .002)) discard; gl_FragColor = vec4(c, al); }",
