      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying float vS, vY, vF; vec3 arcAt(vec3 a, vec3 b, float f, float sd){\n    vec3 d = b - a; float L = length(d); vec3 side = normalize(cross(d, vec3(0., 1., 0.)));\n    float h = fract(sin(sd*91.7)*43758.5), sg = h < .5 ? -1. : 1.;\n    float lat = sg*L*(.03 + .025*fract(h*7.))*sin(3.14159*f) + L*.008*sin(6.28318*f + h*6.);   // main bow + a faint S wobble\n    float up = L*.015*sin(3.14159*f);\n    return mix(a, b, f) + side*lat + vec3(0., up, 0.); }\n    void main(){\n      float u = uTime - aT - 0.40, L = length(aE - aO), tt = L/14.0;\n      if (u < 0. || u > tt + .2){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec3 d = (aE - aO)/L;\n      float head = min(u*14.0, L), tail = max(0., head - .7) + max(0., u - tt)/.2*1.7;   // after the hit, the tail catches up\n      if (head - tail < .01){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5;\n      float fa = mix(tail, head, s)/L;\n      vec3 P = arcAt(aO, aE, fa, 0.), T = normalize(arcAt(aO, aE, min(fa + .01, 1.), 0.) - arcAt(aO, aE, max(fa - .01, 0.), 0.));\n      vec3 side = normalize(cross(T, P - cameraPosition));\n      vS = s; vY = position.y; vF = 1. - clamp((u - tt)/.2, 0., 1.);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*(.02 + .09*s), 1.);\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying float vS, vY, vF;\n    void main(){ float a = pow(vS, 1.6)*exp(-vY*vY*5.), c = pow(vS, 3.)*exp(-vY*vY*30.);\n      vec3 o = (uOrange*a*.45 + mix(uOrange, uGold, .6)*c*.3)*vF;\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.); }",
