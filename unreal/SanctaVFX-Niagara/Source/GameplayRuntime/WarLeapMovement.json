      "vertex": "attribute vec3 aO, aD; attribute float aT; uniform float uTime; varying float vS, vY, vU;\n    vec3 arc(float s){ return mix(aO, aD, s) + vec3(0., 1.70*4.*s*(1. - s) + 1.0, 0.); }\n    void main(){\n      float u = uTime - aT - 0.45; if (u < 0. || u > 1.55){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5;\n      vec3 P = arc(s), T = normalize(arc(min(s + .01, 1.)) - arc(max(s - .01, 0.)));\n      vec3 side = normalize(cross(T, P - cameraPosition));\n      float W = .5;\n      vS = s; vY = position.y*W; vU = u;\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*W, 1.);\n    }",
      "fragment": "uniform vec3 uGold, uOrange; varying float vS, vY, vU; float lcore(float d, float w){ return exp(-(d*d)/(w*w)); }\n    void main(){\n      float s = vS, head = clamp(vU/0.55, 0., 1.);                 // where the Fighter is on the arc\n      float wipe = max(vU - 0.75, 0.)/.6;                    // holds after landing, then fades from the take-off point\n      float alive = smoothstep(head + .01, head - .1, s)*smoothstep(wipe - .05, wipe + .25, s);\n      float prof = sin(3.14159*clamp(s/max(head, .05), 0., 1.));                // thin at take-off and at the body, fullest mid-arc\n      float w = (.006 + .052*pow(prof, 1.2));                                       // wide stroke, fullest mid-arc\n      float d = abs(vY);\n      float band = exp(-pow(d/w, 2.4)), core = lcore(d, w*.3), aura = exp(-pow(d/(w*2.6), 2.))*.08*smoothstep(.5, .32, d);   // soft aura, zero before the strip edge\n      float fade = 1. - smoothstep(1.25, 1.55, vU);\n      vec3 col = mix(uOrange, uGold, .35 + .65*prof);\n      vec3 outc = (col*(band*(.4 + .25*prof) + aura) + mix(uGold, vec3(1., .96, .88), .6)*core*.28*prof)*alive*fade*pow(prof, .7);\n      if (max(outc.r, max(outc.g, outc.b)) < .002) discard;\n      gl_FragColor = vec4(outc, 1.);\n    }",
