      "vertex": "attribute vec3 aO; attribute float aT; attribute vec4 aD; uniform float uTime; varying vec2 vP; varying float vU, vA;\n    void main(){ float u = uTime - aT; if (u < 0. || u > 6. + .9){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float S = 7.0 + .4; vP = position.xy*S; vU = u; vA = aD.x;\n      gl_Position = projectionMatrix*viewMatrix*vec4(aO + vec3(position.x*S, .03, -position.y*S), 1.); }",
      "fragment": "uniform float uTime; uniform vec3 uOrange, uGold, uIceC, uIceP; varying vec2 vP; varying float vU, vA;\n    void main(){\n      float r = length(vP), a = atan(-vP.y, vP.x), R = 7.0*(.3 + .7*(1. - pow(1. - clamp(vU/.45, 0., 1.), 3.)));\n      float side = smoothstep(-.25, .25, cos(a - vA));\n      vec3 c = mix(uIceC, uOrange, side), ch = mix(uIceP, uGold, side);\n      float flow = .75 + .25*sin(a*5. - uTime*.7*(side*2. - 1.));\n      float f = smoothstep(0., .1, vU)*(1. - smoothstep(6., 6. + .8, vU));\n      float pk = vU < .45 ? 1. + 1.2*(1. - vU/.45) : 1.;\n      float line = exp(-pow((r - R)/.03, 2.))*flow, glow = exp(-pow((r - R)/.25, 2.))*.12, wash = smoothstep(R, R*.2, r)*.03;\n      vec3 o = (c*(line*.75 + glow + wash) + ch*exp(-pow((r - R)/.01, 2.))*.35)*f*pk;\n      o *= smoothstep(7.0 + .4, 7.0 + .2, r);\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.);\n    }",
