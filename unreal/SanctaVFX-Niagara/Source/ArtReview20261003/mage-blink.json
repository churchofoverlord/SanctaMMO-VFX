      "vertex": "attribute vec3 aO; attribute float aT, aK; uniform float uTime; varying vec2 vP; varying float vU, vK;\n    void main(){ float u = uTime - aT; if (u < 0. || u > .87){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float S = 1.; vP = position.xy*S; vU = u; vK = aK;\n      gl_Position = projectionMatrix*viewMatrix*vec4(aO + vec3(position.x*S, .03, -position.y*S), 1.); }",
      "fragment": "uniform vec3 uV, uBl, uW; varying vec2 vP; varying float vU, vK; float lcore(float d, float w){ return exp(-(d*d)/(w*w)); }\n    void main(){\n      float r = length(vP), a = atan(vP.y, vP.x), t = vU/.87;\n      float k = vK < .5 ? pow(clamp(vU/.4, 0., 1.), 2.) : 1. - pow(1. - clamp(vU/.4, 0., 1.), 3.);\n      float R = vK < .5 ? mix(.8, .25, k) : mix(.25, .8, k);                  // origin closes, destination opens\n      float f = mix(1.7,1.,smoothstep(0.,.07,vU))*(1. - smoothstep(.5, 1., t));\n      float ring = exp(-pow(abs(r - R)/.018, 2.4)), inner = exp(-pow(abs(r - R*.72)/.01, 2.4))*.6;\n      float ticks = smoothstep(.6, .95, abs(cos(a*12.)))*exp(-pow(abs(r - R*.86)/.03, 2.))*.7;   // sigil ticks between the rings\n      float glow = exp(-r*r*6.)*(vU < .1 ? .9 : .25*(1. - t));\n      vec3 o = (uV*(ring + inner + ticks) + uBl*glow + uW*lcore(r - R, .005)*.6)*f*smoothstep(1., .9, r);\n      if (max(o.r, max(o.g, o.b)) < .002) discard;\n      gl_FragColor = vec4(o, 1.);\n    }",
