      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying vec3 vN, vV;\n    void main(){\n      float u = uTime - aT - 0.10, L = length(aE - aO), tt = L/24.0;\n      if (u < 0. || u > tt){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vec3 d = (aE - aO)/L, up = vec3(0., 1., 0.), sd = normalize(cross(d, up)), vu = cross(sd, d);\n      float a = -u*30.;                                      // spins end over end (~5 turns/s) in the vertical plane of the throw\n      vec3 lx = d*cos(a) + vu*sin(a), ly = -d*sin(a) + vu*cos(a);\n      vec3 P = mix(aO, aE, u/tt) + d*.05 + lx*position.x + ly*position.y + sd*position.z;   // just ahead of the trail head\n      vN = normalize(lx*normal.x + ly*normal.y + sd*normal.z); vV = normalize(cameraPosition - P);\n      gl_Position = projectionMatrix*viewMatrix*vec4(P, 1.);\n    }",
      "fragment": "uniform vec3 uGold, uMoon; varying vec3 vN, vV;\n    void main(){ vec3 n = normalize(vN); float l = .18 + .7*max(dot(n, uMoon), 0.), rim = pow(1. - abs(dot(n, normalize(vV))), 3.);\n      gl_FragColor = vec4(vec3(.62, .6, .6)*l*.7 + uGold*(.12 + rim*1.3), 1.); }",
