      "vertex": "attribute vec3 aO; attribute float aT, aK, aM; uniform float uTime; varying vec2 vP; varying float vAge, vK, vM;\n    void main(){\n      float age = uTime - aT; if (age < 0. || age > 1.21){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      vAge = age; vK = aK; vM = aM;\n      if (aM < .5){\n        float S = 1.9, Sw = 1.15; vP = position.xy*S;                  // horizontal plane at the waist, not a ground decal\n        gl_Position = projectionMatrix*viewMatrix*vec4(aO + vec3(position.x*Sw, .95, -position.y*Sw), 1.);\n      } else {\n        if (age < 0.26){ gl_Position = vec4(2.,2.,2.,1.); return; }\n        vec4 mv = viewMatrix*vec4(aO + vec3(0., 1.22, 0.), 1.); mv.xyz += normalize(-mv.xyz)*.38;\n        float S = .42; mv.xy += position.xy*S; vP = position.xy*S;\n        gl_Position = projectionMatrix*mv;\n      }\n    }",
      "fragment": "uniform vec3 uCR, uCB; varying vec2 vP; varying float vAge, vK, vM; float eox(float x){ return x >= 1. ? 1. : 1. - pow(2., -10.*x); } float stroke(float d, float w){ return exp(-(d*d)/(w*w)) + .28*exp(-(d*d)/(w*w*22.)); }\n  float lcore(float d, float w){ return exp(-(d*d)/(w*w)); }\n    float box(vec2 p, vec2 b){ vec2 d = abs(p) - b; return length(max(d,0.)) + min(max(d.x,d.y),0.); }\n    void main(){\n      vec2 p = vP; float r = length(p), ph = atan(p.y, p.x), T = 0.26;\n      vec3 col = mix(uCR, uCB, vK);\n      float lum = 0., hot = 0.;\n      if (vM < .5){\n        if (vAge < T){\n          // spiral strokes sweep in across the floor and gather under the feet\n          float t = vAge/T, e = t*t, R = mix(1.7, .14, e);\n          for (int i=0;i<5;i++){\n            float h = float(i)*1.2566 + e*2.6 + .6*(1.-vK);\n            float dl = mod(h - ph, 6.28318), L = 1.3;\n            if (dl < L){\n              float s = dl/L, rr = R + dl*.28*(1. - e*.6), w = (.014 + .026*(1.-s))*(1. - e*.4), fall = pow(max(1.-s,0.),1.8)*smoothstep(0.,.07,s)*(.35 + .65*t);\n              lum += stroke(r - rr, w)*fall; hot += lcore(r - rr, w*.4)*fall*(1.-s);\n            }\n          }\n          lum += exp(-r*r*18.)*t*t*1.4;\n        } else {\n          float u = vAge - T;\n          lum += exp(-r*r*6.)*((u < .033 ? 2. : 0.) + .9*exp(-u*8.));\n          for (int j=0;j<2;j++){                     // Rage: two quick heal pulses; Bulwark: one\n            float uj = u - float(j)*.09;\n            if (uj < 0. || (j == 1 && vK > .5)) continue;\n            float rr = .15 + eox(clamp(uj/.32, 0., 1.))*1.55, f = 1. - clamp(uj/.36, 0., 1.);\n            lum += (lcore(r - rr, .016)*1.2 + exp(-pow((r-rr)/.11, 2.))*.3)*f*f*(j == 0 ? 1. : .7);\n            hot += lcore(r - rr, .008)*f*f*.6;\n          }\n        }\n      } else {\n        float u = vAge - T, em = 1.7*exp(-u*3.2) + .25*exp(-u*1.2);\n        float cross = min(box(p, vec2(.028,.13)), box(p, vec2(.13,.028)));\n        float top = .13, tip = -.16, hw = .12, wy = p.y > 0. ? hw : hw*clamp((p.y - tip)/(0. - tip), 0., 1.);\n        float sd = max(abs(p.x) - wy, max(p.y - top, tip - p.y));\n        float d = mix(cross, sd, vK);\n        lum += (stroke(d, .006) + .14*step(d, 0.))*em + exp(-r*r*60.)*em*.3; hot += lcore(d, .004)*em*.8;\n      }\n      vec3 outc = col*lum + mix(col, vec3(1., .95, .92), .6)*hot;\n      if (max(outc.r, max(outc.g, outc.b)) < .002) discard;\n      outc*=smoothstep(1.9,1.78,r);gl_FragColor = vec4(outc, 1.);\n    }",
