      "vertex": "attribute vec3 aO, aE; attribute float aT; uniform float uTime; varying float vS, vY, vU;\n    vec3 arcAt(float f){ float L = length(aE - aO); return mix(aO, aE, f) + vec3(0., min(.7, .14*L)*4.*f*(1. - f), 0.); }\n    void main(){\n      float u = uTime - aT; if (u < 0. || u > 1.17){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float s = position.x*.5 + .5;\n      vec3 P = arcAt(s), T = normalize(arcAt(min(s + .01, 1.)) - arcAt(max(s - .01, 0.)));\n      P += cross(T, vec3(0., 1., 0.))*.035*sin(s*17. + u*16.)*sin(3.14159*s);            // electric jitter\n      vec3 side = normalize(cross(T, P - cameraPosition));\n      vS = s; vY = position.y; vU = u;\n      gl_Position = projectionMatrix*viewMatrix*vec4(P + side*position.y*.26, 1.);\n    }",
      "fragment": "uniform vec3 uV, uBl, uW; varying float vS, vY, vU;\n    void main(){\n      float head = clamp((vU - 0.670)/0.200, 0., 1.);                // leaves once the fade-out is complete, arrives as the fade-in starts\n      float tail = clamp((vU - 0.870)/.25, 0., 1.);                    // as soon as it reaches the destination, retracts from the origin into it\n      float alive = smoothstep(head + .02, head - .06, vS)*smoothstep(tail - .02, tail + .12, vS);\n      float fl = .88 + .12*sin(vU*20. + vS*20.);\n      float twist = sin(vS*40. - vU*14.)*.35;                                   // two strands twisting around the core\n      float band = exp(-vY*vY*3.5)*smoothstep(1., .75, abs(vY)), core = exp(-vY*vY*30.);\n      float strands = exp(-pow((vY - twist)/.09, 2.)) + exp(-pow((vY + twist)/.09, 2.));\n      vec3 o = (uBl*band*.3 + uV*(band*.35 + strands*.5) + uW*core*.8*fl)*alive*pow(smoothstep(0., .08, vS)*smoothstep(1., .97, vS), .5);   // full brightness right up to the destination head\n      if (max(o.r, max(o.g, o.b)) < .002) discard; gl_FragColor = vec4(o, 1.);\n    }",
