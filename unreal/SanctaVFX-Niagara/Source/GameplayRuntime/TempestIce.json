      "vertex": "attribute vec3 aO; attribute vec4 aS, aD; attribute float aT; attribute vec2 aX; attribute vec3 bary; uniform float uTime; varying vec3 vN, vV, vB; varying vec2 vQ; varying float vH, vSeed, vCrack;\n    void main(){\n      float u = uTime - aT - aD.x; if (u < 0. || u > 0.90 + .5){ gl_Position = vec4(2.,2.,2.,1.); return; }\n      float du = aX.x > 0. ? uTime - aX.x : -1.; if (du > .16){ gl_Position = vec4(2.,2.,2.,1.); return; }          // destroyed: pillar collapses in 0.16 s (shards take over)\n      float br = du > 0. ? 1. - du/.16 : 1.;\n      float k = clamp(u/.3, 0., 1.), rise = 1., fall = 1. - k*k;                 // Tempest: icicle falls from the cloud (ease-in)\n      float sink = smoothstep(0.90, 0.90 + .45, u);\n      vec3 p = position*vec3(aS.x, aS.y, aS.x); p.y = aS.y - p.y;   // Frost Lance blade flipped: point down\n      float cy = cos(aS.z), sy = sin(aS.z); p = vec3(cy*p.x - sy*p.z, p.y, sy*p.x + cy*p.z);\n      vec3 n = normalize(normal/vec3(aS.x, -aS.y, aS.x)); n = vec3(cy*n.x - sy*n.z, n.y, sy*n.x + cy*n.z);\n      float ct = cos(aS.w), st = sin(aS.w), td = aD.y;                        // lean outward a little\n      vec3 ax = vec3(cos(td), 0., sin(td));\n      p = p*ct + cross(ax, p)*st + ax*dot(ax, p)*(1. - ct); n = n*ct + cross(ax, n)*st + ax*dot(ax, n)*(1. - ct);\n      p *= vec3(1. + (1. - br)*.3, br, 1. + (1. - br)*.3);\n      vec3 W = aO + p + vec3(0., fall*(6.2 - aS.y) - .22*aS.y*(1. - fall) - sink*aS.y*1.05, 0.);\n      vN = n; vV = normalize(cameraPosition - W); vH = position.y; vSeed = aD.z; vCrack = aX.y; vB = bary; vQ = vec2((position.x - position.z)*aS.x + aD.z*9., position.y*aS.y);\n      gl_Position = projectionMatrix*viewMatrix*vec4(W, 1.);\n    }",
      "fragment": "uniform vec3 uMoon; varying vec3 vN, vV, vB; varying vec2 vQ; varying float vH, vSeed, vCrack; \n  uniform sampler2D uBG; uniform vec2 uRes;\n  float ih(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7)))*43758.5453); }\n  float ivn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3. - 2.*f);\n    return mix(mix(ih(i), ih(i + vec2(1., 0.)), f.x), mix(ih(i + vec2(0., 1.)), ih(i + vec2(1., 1.)), f.x), f.y); }\n  float ivn3(vec3 p){ return mix(ivn(p.xy + floor(p.z)*17.13), ivn(p.xy + (floor(p.z) + 1.)*17.13), smoothstep(0., 1., fract(p.z))); }\n  /* n: facet normal (world, facing the camera) · V: to camera · B: unused · h: 0 base → 1 point · q: coords on the crystal\n     (x across, y along) · L: key light. Opaque output: the background comes in through the refraction. */\n  vec4 iceShade(vec3 n,vec3 V,vec3 B,float h,vec2 q,vec3 L){\n n=dot(n,V)<0.?-n:n;float nv=clamp(dot(n,V),0.,1.),fr=.028+.972*pow(1.-nv,5.);\n vec3 R=reflect(-V,n);float spec=pow(max(dot(R,normalize(L)),0.),90.)*1.9+pow(max(dot(R,normalize(V+vec3(-.3,.55,.2))),0.),65.)*.65;\n float thick=(.3+.7*nv)*(1.-.65*clamp(h,0.,1.));float cloud=ivn(q*1.6+vec2(4.7))*.8+ivn(q*3.1)*.2;\n float frost=smoothstep(.64,.88,cloud)*thick,crack=pow(1.-abs(fract(q.y*1.7+q.x*.9)-.5)*2.,55.)*.10*thick;\n vec3 vn=(viewMatrix*vec4(n,0.)).xyz;vec2 suv=gl_FragCoord.xy/uRes;\n vec3 bg=texture2D(uBG,suv-vn.xy*.014*thick).rgb;\n vec3 glass=mix(vec3(.62,.82,.91),vec3(.18,.43,.57),thick);\n vec3 col=bg*glass*.40+glass*(.38+.16*fr)+vec3(.72,.86,.94)*(frost*.25+crack)+vec3(.95,.98,1.)*spec;\n float opacity=clamp(.36+.44*thick+.12*frost+spec*.08,.34,.94);\n return vec4(col,opacity); }\n    void main(){\n      vec3 n = normalize(vN); if (!gl_FrontFacing) n = -n;\n      gl_FragColor = iceShade(n, normalize(vV), vB, vH, vQ, uMoon);            /* shared ice: translucent, bright facet edges, cold point */\n    }",
